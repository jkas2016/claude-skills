#!/usr/bin/env bash
set -Eeuo pipefail

if [[ $# -lt 2 || $# -gt 3 ]]; then
  printf 'Usage: wt-create <registered-repo-path> <new-branch> [remote-base-branch]\n' >&2
  exit 2
fi

repo=$(git -C "$1" rev-parse --show-toplevel)
source_git=$(git -C "$repo" rev-parse --absolute-git-dir)
if [[ $source_git != "$(git -C "$repo" rev-parse --path-format=absolute --git-common-dir)" ]]; then
  printf 'Pass the registered original repository path: %s\n' "$repo" >&2
  exit 2
fi
branch=$2
base=${3-master}
git check-ref-format "refs/heads/$base"
git check-ref-format --branch "$branch" >/dev/null
orca_cli=${ORCA_CLI_COMMAND:-orca}
command -v "$orca_cli" >/dev/null
command -v jq >/dev/null || {
  printf 'wt-create requires jq to read the Orca response.\n' >&2
  exit 1
}

# Read this fetch's result directly. Linked worktrees share the object store.
fetch_result=$(git -C "$repo" fetch --porcelain --no-auto-maintenance --refmap= --depth=1 \
  --no-tags --no-recurse-submodules origin "refs/heads/$base")
base_commit=$(awk '$4 == "FETCH_HEAD" {print $3}' <<< "$fetch_result")
git -C "$repo" cat-file -e "${base_commit:?No commit returned by fetch}^{commit}"

printf 'Base: origin/%s %s\n' "$base" "$base_commit" >&2
creation=$("$orca_cli" worktree create --repo "path:$repo" --name "$branch" --branch "$branch" \
  --base-branch "$base_commit" --no-parent --json) || {
  status=$?
  printf '%s\n' "$creation"
  exit "$status"
}
printf '%s\n' "$creation"
worktree=$(jq -er 'select(.ok == true) | .result.worktree.path | strings | select(startswith("/"))' <<< "$creation")
worktree=$(cd "$worktree" && pwd -P)

# Apply the project-specific policy by repository identity, including renamed clones.
submodule_branch=
origin=$(git -C "$repo" config --get remote.origin.url | tr '[:upper:]' '[:lower:]')
case ${origin%/} in
  git@git.nwz.kr:gamfs4/projectb4|git@git.nwz.kr:gamfs4/projectb4.git|\
  ssh://git@git.nwz.kr/gamfs4/projectb4|ssh://git@git.nwz.kr/gamfs4/projectb4.git|\
  https://git.nwz.kr/gamfs4/projectb4|https://git.nwz.kr/gamfs4/projectb4.git)
    submodule_branch=$(git -C "$worktree" symbolic-ref --short HEAD)
    ;;
esac

report_failure() {
  printf 'Worktree retained: %s\n' "$worktree" >&2
  if [[ -n ${module_path:-} ]]; then
    if [[ -n $submodule_branch ]]; then
      printf 'Submodule initialization failed: %s (origin/%s)\n' "$module_path" "$submodule_branch"
    else
      printf 'Submodule initialization failed: %s (pin %s)\n' "$module_path" "$pin"
    fi >&2
  fi
}
trap report_failure ERR
if [[ $(git -C "$worktree" rev-parse HEAD) != "$base_commit" ]] ||
   [[ $(git -C "$worktree" rev-parse --path-format=absolute --git-common-dir) != \
      "$source_git" ]]; then
  printf 'Orca worktree does not match the requested repository and base.\n' >&2
  report_failure
  exit 1
fi

module_url() (
  # The caller reports failure with the module path and pin.
  trap - ERR
  set -e
  local tree=$1 name=$2 path=$3 url scratch index remote format
  if url=$(git -C "$tree" config --get "submodule.$name.url"); then
    printf '%s\n' "$url"
    exit
  fi
  url=$(git -C "$tree" config --file .gitmodules --get "submodule.$name.url")
  case $url in
    ./*|../*)
      # Let Git resolve relative URLs without writing to the superproject config.
      scratch=$(mktemp -d)
      trap 'rm -rf "$scratch"' EXIT
      format=$(git -C "$tree" rev-parse --show-object-format)
      git init --quiet --bare --template= --object-format="$format" "$scratch"
      index=$(git -C "$tree" rev-parse --path-format=absolute --git-path index)
      remote=$(git -C "$tree" symbolic-ref --quiet --short HEAD || :)
      remote=$(git -C "$tree" config --get "branch.$remote.remote" || printf origin)
      url=$(git -C "$tree" remote get-url "$remote" || printf '%s' "$tree")
      git --git-dir="$scratch" config remote.origin.url "$url"
      GIT_INDEX_FILE="$index" git --git-dir="$scratch" --work-tree="$tree" \
        -C "$tree" submodule init --quiet -- ":(literal)$path"
      git --git-dir="$scratch" config --get "submodule.$name.url"
      ;;
    *) printf '%s\n' "$url" ;;
  esac
)

init_modules() {
  local tree=$1 source_git=$2 register=${3:-false}
  local entry meta path key name candidate module_git donor objects shallow url format
  local module_path= pin= mode type complete=false remote_head remote_ref tracking_ref
  local -a module_keys=() module_paths=()
  if [[ -f $tree/.gitmodules ]]; then
    git -C "$tree" config --file .gitmodules --list >/dev/null
    while IFS= read -r -d '' entry; do
      module_keys+=("${entry%%$'\n'*}")
      module_paths+=("${entry#*$'\n'}")
    done < <(git -C "$tree" config --file .gitmodules --null --get-regexp '^submodule\..*\.path$')
  fi
  while IFS= read -r -d '' entry; do
    if [[ -z $entry ]]; then
      complete=true
      break
    fi
    meta=${entry%%$'\t'*}
    read -r mode type pin <<< "$meta"
    [[ $mode == 160000 ]] || continue
    path=${entry#*$'\t'}
    module_path=$tree/$path
    name=
    for key in "${!module_keys[@]}"; do
      if [[ ${module_paths[key]} == "$path" ]]; then
        candidate=${module_keys[key]#submodule.}
        name=${candidate%.path}
        break
      fi
    done
    # The logical name becomes part of a Git directory path.
    case /$name/ in
      *'/../'*|*'/./'*|*/.[gG][iI][tT]/*|*'//'*)
        printf 'Missing or invalid submodule name for %s\n' "$path" >&2
        return 1
        ;;
    esac
    [[ $name != *'\'* ]]
    donor=
    if [[ -n $source_git && -d $source_git/modules/$name/objects ]]; then
      donor=$source_git/modules/$name
    fi

    mkdir -p "$module_path"
    [[ $(cd "$module_path" && pwd -P) == "$module_path" ]]
    module_git=$(git -C "$tree" rev-parse --path-format=absolute --git-path "modules/$name")
    if [[ -n $submodule_branch ]]; then
      url=$(module_url "$tree" "$name" "$path")
      remote_ref=refs/heads/$submodule_branch
      tracking_ref=refs/remotes/origin/$submodule_branch
      if remote_head=$(GIT_PROTOCOL_FROM_USER=0 git -C "$tree" ls-remote --exit-code --refs -- "$url" "$remote_ref"); then
        pin=$(awk -v ref="$remote_ref" '$2 == ref {print $1}' <<< "$remote_head")
        if [[ -z $pin ]]; then
          printf 'Missing remote branch %s for %s\n' "$remote_ref" "$module_path" >&2
          return 1
        fi
      else
        if [[ $? == 2 ]]; then
          printf 'Missing remote branch %s for %s\n' "$remote_ref" "$module_path" >&2
        fi
        return 1
      fi
    fi
    if [[ -e $module_path/.git || -L $module_path/.git ]]; then
      # Setup hooks may already have initialized this module.
      [[ $(git -C "$module_path" rev-parse --absolute-git-dir) == "$module_git" ]]
      [[ $(git -C "$module_path" rev-parse HEAD) == "$pin" ]]
      if [[ -n $submodule_branch ]]; then
        [[ $(git -C "$module_path" symbolic-ref --quiet HEAD) == "$remote_ref" ]]
        [[ $(git -C "$module_path" rev-parse --symbolic-full-name '@{upstream}') == "$tracking_ref" ]]
        [[ $(git -C "$module_path" rev-parse "$tracking_ref") == "$pin" ]]
      fi
    else
      if [[ -z $submodule_branch ]]; then
        url=$(module_url "$tree" "$name" "$path")
      fi
      [[ -n $url ]]
      [[ ! -e $module_git && ! -L $module_git ]]
      mkdir -p "${module_git%/*}"
      [[ $(cd "${module_git%/*}" && pwd -P) == "${module_git%/*}" ]]
      format=$(git -C "$tree" rev-parse --show-object-format)
      git init --quiet --template= --object-format="$format" \
        --separate-git-dir="$module_git" "$module_path"
      git -C "$module_path" config core.worktree "$module_path"
      git -C "$module_path" config remote.origin.url "$url"
      git -C "$module_path" config remote.origin.fetch '+refs/heads/*:refs/remotes/origin/*'

      if [[ -n $donor ]]; then
        # Git's --reference rejects shallow donors. Share objects directly and
        # keep the borrower's shallow boundaries in its own Git directory.
        objects=$(cd "$donor/objects" && pwd -P)
        [[ $objects != *$'\n'* ]]
        printf '%s\n' "$objects" >"$module_git/objects/info/alternates"
        shallow=$(git --git-dir="$donor" rev-parse --path-format=absolute --git-path shallow)
        if [[ -s $shallow ]]; then
          cp "$shallow" "$module_git/shallow"
        fi
      fi
      if git -C "$module_path" cat-file -e "$pin^{commit}" 2>/dev/null; then
        # A cached pin can be present even when its parents are outside the cache.
        if [[ -s $module_git/shallow ]] && ! grep -Fxq "$pin" "$module_git/shallow"; then
          printf '%s\n' "$pin" >>"$module_git/shallow"
        fi
      else
        GIT_PROTOCOL_FROM_USER=0 git -C "$module_path" fetch --depth=1 --no-tags \
          --no-auto-maintenance --no-recurse-submodules origin "$pin"
      fi
      if [[ -n $submodule_branch ]]; then
        git -C "$module_path" update-ref "$tracking_ref" "$pin"
        git -C "$module_path" checkout --quiet --no-recurse-submodules --track \
          -b "$submodule_branch" "$tracking_ref"
      else
        git -C "$module_path" checkout --quiet --no-recurse-submodules --detach "$pin"
      fi
    fi
    if [[ $register == true ]]; then
      # A nested module's parent config belongs to this worktree alone.
      git -C "$tree" config "submodule.$name.active" true
    fi
    init_modules "$module_path" "$donor" true
  done < <(git -C "$tree" ls-tree -rz --full-tree HEAD && printf '\0')
  [[ $complete == true ]]
}

init_modules "$worktree" "$source_git" >&2
